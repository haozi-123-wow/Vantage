# --- Node -------------------------------------------------------------------
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# npm 缓存目录（放在仓库内时忽略），别提交
.npm-cache/

# Go 的 GOPATH / GOCACHE / 模块缓存改用工作区内目录时的落点
.gocache/
.gopath/
.gomodcache/

# Agent 侧临时草稿目录（约定命名 agent/tmp_*/；⛔ 不要用宽泛的 tmp* 以免误伤正式代码）
agent/tmp_*/

# --- 密钥与环境 -------------------------------------------------------------
# ⛔ 绝不提交：含 SECRET_KEY 与数据库口令
.env
.env.*
!.env.example

# --- 运行产物 ---------------------------------------------------------------
*.log
coverage/
dist/
tmp/
.cache/
_dump/
*.pid

# --- 工具产物 ---------------------------------------------------------------
# DSH（编码 Agent）的编辑审查日志与临时目录：体积大且只对本机会话有意义
.dsh-edit-review*.json
.dsh-*.tmpdir/

# --- 发布私钥（兜底）--------------------------------------------------------
# build-release.sh --keygen 默认写在 dist/（已忽略）；这里再兜一层，
# 防止有人用 --out 指到别处后误入库。⛔ 私钥永不进仓库。
release.key
*-release.key
*.privkey.pem
design/
