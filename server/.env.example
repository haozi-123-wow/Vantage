# =============================================================================
# Vantage · vantage-core 环境变量样例
#
# 用法：cp .env.example .env  然后填值（⛔ .env 不要提交到仓库，见 .gitignore）
#
# 优先级：**进程环境变量 > .env 文件**（容器/编排里注入的值会覆盖文件，便于部署时微调）
# 校验：任何一项不合法都会在启动时**一次性列出全部问题**并退出（见 src/config/index.js）
# =============================================================================

# --- 运行环境 ----------------------------------------------------------------
# development / test / production（production 会收紧日志级别与 Cookie Secure）
NODE_ENV=development

# --- HTTP 接入层 -------------------------------------------------------------
# 默认只监听回环：公网入口一律走反代（Caddy/Nginx），见设计 §12.1
HOST=127.0.0.1
PORT=8787

# X-Forwarded-For 可信代理。反代后填 1 / loopback / CIDR 列表。
# ⚠️ 这决定 client IP 的真实性 → 直接影响 audit_logs.ip 与 agent_ip_history.ip（§13），
#    填「true」等于信任任何伪造头，⛔ 不要在生产这么写。
TRUST_PROXY=loopback

# 面板对外地址（用于 WS Origin 白名单等）。留空 = 不校验 Origin ⚠️
PUBLIC_ORIGIN=

# --- 日志 --------------------------------------------------------------------
# fatal / error / warn / info / debug / trace / silent
LOG_LEVEL=debug

# --- PostgreSQL --------------------------------------------------------------
# 运行时连接：只用最小权限角色 vantage_app（仅 DML，⛔ 无 DDL）
# ⚠️ 口令里含 @ : / # ? % 等字符时同样要百分号编码（规则与上面的 REDIS_URL 完全一致）：
#    postgres://vantage_app:p%40ss%2Fword@127.0.0.1:5432/vantage
DATABASE_URL=postgres://vantage_app:CHANGE_ME@127.0.0.1:5432/vantage

# 迁移/分区维护连接：拥有 DDL 权限的角色 vantage_migrator
# （留空则回退到 DATABASE_URL；生产建议**分开配置**，见 docs/database.md §2）
MIGRATOR_DATABASE_URL=postgres://vantage_migrator:CHANGE_ME@127.0.0.1:5432/vantage

PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
# 单语句超时（毫秒）——防止慢查询占住连接；迁移脚本不受此限制
PG_STATEMENT_TIMEOUT_MS=15000
# 连接复用上限，缓解服务端连接内存膨胀
PG_MAX_USES=7500

# --- Redis -------------------------------------------------------------------
# ✅ R15：单实例、不拆 DB index、各用途靠键名前缀区分；且必须 maxmemory-policy=noeviction
#
# 🔑 Redis 口令有两种给法，**只选一种**（另一种务必留空）：
#
#   ① 内联在 URL 里（适合简单口令）
#        REDIS_URL=redis://:你的口令@127.0.0.1:6379/0
#        REDIS_URL=redis://ACL用户名:你的口令@127.0.0.1:6379/0     # Redis 6+ ACL
#        ⚠️ 口令含下列字符时**必须百分号编码**，否则 ioredis 用 WHATWG `new URL()` 解析：
#           `/` 会直接抛 `TypeError: Invalid URL`（启动即崩）；
#           `#` 会被当成 fragment、`?` 会被当成 query —— **静默解析错**，最难查。
#           @→%40   :→%3A   /→%2F   #→%23   ?→%3F   %→%25
#           例：口令 `p@ss/word` → `redis://:p%40ss%2Fword@127.0.0.1:6379/0`
#
#   ② 分立变量（**推荐**：口令不必编码，适合随机生成的口令）
#        REDIS_URL=redis://127.0.0.1:6379/0
#        REDIS_USERNAME=vantage        # 可留空；用了 ACL 用户才需要
#        REDIS_PASSWORD=<随机口令>
#
#   ⛔ 两边同时写**不是双保险而是歧义**：ioredis 按参数顺序做 defaults，URL 里的凭据会压过选项，
#      改 REDIS_PASSWORD 会毫无效果。代码检测到冲突时会**丢弃 URL 中的凭据**并打一条 warn。
#   ⛔ 密码只在 .env 里，不要提交仓库（.gitignore 已忽略 .env）；日志里一律脱敏。
REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_USERNAME=
# REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES_PER_REQUEST=3

# --- 加密主密钥（必需）-------------------------------------------------------
# 用途：加密 channels.config 敏感项、users.totp_secret_enc，以及 agents.agent_secret_enc
# 生成（32 字节 → base64）：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# ⛔ 一旦有数据入库就**不可更换**（换了旧密文全部解不开）；请妥善备份（建议走 secret 管理，不入仓库）
SECRET_KEY=

# 设置项 Redis 缓存 TTL（秒），✅ R16：变更时主动失效，不必重启
SETTINGS_CACHE_TTL_S=30

# --- 上报通道限制（✅ 决策 #47）---------------------------------------------
MAX_COMPRESSED_BYTES=1048576
MAX_DECOMPRESSED_BYTES=4194304

# --- Agent 鉴权（✅ §6.2 / 决策 #36）-----------------------------------------
# 签名窗口（秒）：普通模式下的期望窗口；硬上限恒为 300s（决策 #17）
SIGNATURE_WINDOW_S=300
# ✅ 决策 #17：默认「接受 + 修正 + 告警」——只要不越过 5min 硬上限就收下，
#    仅当 |now-ts| 超过 5min 才 401 timestamp_skew。
#    设为 true 则收紧为「超窗即拒」（阈值 = SIGNATURE_WINDOW_S）——**opt-in**，默认关。
SIGNATURE_STRICT=false
# nonce 防重放 TTL（秒）：必须 ≥ SIGNATURE_WINDOW_S
NONCE_TTL_S=600
# 过期上报丢弃阈值（小时）：中心丢弃 ts 迟于该值的上报（§5.3）
# ⚠️ M1 未使用：5min 硬上限已覆盖该区间；它更适合作为 M3 离线判定的「确定离线」阈值
STALE_REPORT_HOURS=6

# --- 面板会话（✅ §18.1 / 决策 #31/#32）--------------------------------------
SESSION_SLIDING_TTL_S=1800
SESSION_ABSOLUTE_TTL_S=86400
SESSION_MAX_PER_USER=3
COOKIE_NAME=vantage_sid
# 生产（HTTPS）必须 true；本地 http 调试可设 false
COOKIE_SECURE=false

# --- 限流（✅ 决策 #23；数值为 docs/api.md §1.4 建议值）----------------------
RATELIMIT_AGENT_PER_MINUTE=60
RATELIMIT_PUBLIC_PER_MINUTE=60
RATELIMIT_LOGIN_PER_WINDOW=10
RATELIMIT_LOGIN_WINDOW_S=300
RATELIMIT_WS_CONCURRENT_PER_IP=3

# --- 人机验证（✅ C12 已定 = G1-a；docs/geetest-captcha.md §8.1）------------------------
# 提供方三选一：geetest（极验 v4）| selfbuilt（自建滑块，零外部依赖）| none（关闭）
# ⚠️ **未设置时自动推断**：配了下面两个极验密钥 → geetest；否则 → selfbuilt。
#    这样"还没接极验"的部署升级后照常启动（回退到自建滑块，依然有人机验证）。
# ⛔ 显式写 geetest 却缺密钥 → **启动即失败**：绝不允许"声明用极验但没给密钥"的进程
#    跑起来后在运行时静默放行（docs/geetest-captcha.md §9.4 教训一）。
# CAPTCHA_PROVIDER=geetest

# 极验后台获取。⛔ captcha_id 是**公开**值（下发给前端）；captcha_key 是**机密**（只用于算 sign_token）
# ⛔ 都不要提交仓库；captcha_key 泄露 = 任何人都能伪造"验证通过"
GEETEST_CAPTCHA_ID=
GEETEST_CAPTCHA_KEY=
# 二次校验地址（只写域名，协议固定 https）。备用域名清单见 docs/geetest-captcha.md §8.5
GEETEST_API_SERVER=gcaptcha4.geetest.com
# 二次校验超时（毫秒）。⚠️ 闸门在验密**之前**，超时直接表现为"点登录卡住"，故默认比官方 demo(5000) 短
GEETEST_TIMEOUT_MS=3000
# 极验不可达时：open=放行（默认，与极验官方容灾口径一致）| closed=拒绝（503 captcha_unavailable）
# ⛔ 选 open 的代价：该层此刻不生效（靠登录限流 + Argon2 + TOTP 兜底）；
#    收益：监控系统故障时运维**仍能登进自己的面板**。详见 docs/geetest-captcha.md §9。
GEETEST_FAIL_MODE=open
# 官方按钮形态（✅ C16 已定 = 用极验的官方按钮）：popup=按钮+带遮罩的验证弹窗 | float=按钮+浮动验证层
# ⛔ 不支持 bind（该模式根本不渲染按钮）；改这个值**不需要改前端代码**
GEETEST_PRODUCT=popup
# 验证窗内文案的语言（极验自己渲染，⛔ 不受本站 i18n 控制）：zho / eng / zho-tw / jpn / ...
GEETEST_LANGUAGE=zho

# 自建滑块的工程常量（仅 provider=selfbuilt 时生效）
CAPTCHA_TTL_S=120
CAPTCHA_TOLERANCE_PX=5
CAPTCHA_MAX_ATTEMPTS=3
# 取题/验题限流（独立桶：⛔ "换一张图"不该消耗登录额度）
RATELIMIT_CAPTCHA_PER_MINUTE=30

# --- 数据保留期（✅ 决策 #11/#38，改小不报错、改大有磁盘风险）---------------
RETENTION_METRICS_RAW_DAYS=15
RETENTION_METRICS_1M_DAYS=90
RETENTION_METRICS_5M_DAYS=365
RETENTION_PROBE_RESULTS_DAYS=90
RETENTION_PROCESS_SNAPSHOTS_DAYS=30
RETENTION_AGENT_IP_HISTORY_DAYS=180
RETENTION_NOTIFICATION_LOG_DAYS=180
RETENTION_AUDIT_LOGS_DAYS=365
RETENTION_SILENCE_KEEP_DAYS=7
# 分批 DELETE 的批大小（避免长事务与表膨胀）
RETENTION_DELETE_BATCH_SIZE=10000
# 分区维护：预建未来几天（建议 ≥ 7，且需大于「核心停机最长天数」）
PARTITION_PRE_CREATE_DAYS=7

# --- 心跳与离线判定（✅ §5.3）-----------------------------------------------
# 离线阈值 = 该机上报周期 × 该倍数
OFFLINE_CYCLES_MULTIPLIER=3
HEARTBEAT_SWEEP_INTERVAL_S=30

# --- IP 变化防抖 / Flapping（✅ 决策 #39、设计 §8）--------------------------
# 判据：同一 Agent 在 FLAPPING_WINDOW_S 内 IP 变化**超过** FLAPPING_CHANGES 次
#       → 进入 Flapping 态（只记一条 flapping 事件、暂停 IP 变化类告警），
#         稳定后由 Flapping 恢复定时任务解除（M3）。
# 默认 600s / 3 次，与 alert_rules.params 中 ip_change.mode='frequent' 的 window_s/changes 同口径。
FLAPPING_WINDOW_S=600
FLAPPING_CHANGES=3

# --- 定时任务（✅ 决策 #50：core 内置 + 分布式锁）----------------------------
# 服务**启动时会立即补建一次分区**，因此关掉服务的期间不会消耗分区提前量。
# ⛔ CRON_ENABLED=false 会让分区预建/降采样/保留期清理全部停摆：
#    分区提前量耗尽后写入会落进兜底分区（且**无法事后补建**），降采样停摆后
#    "原始数据过期 → 永久空洞" 的风险窗口随之打开。仅排障时临时关闭。
CRON_ENABLED=true
# 每日类任务（建/删分区、两项清理）的执行时刻：UTC 小时，避开业务高峰
CRON_DAILY_UTC_HOUR=3
# 分布式锁 TTL（秒）：任务幂等，锁超时重跑无害，取一个"大于最长任务耗时"的值即可
CRON_LOCK_TTL_S=900
# 聚合频率（秒）：1m 档每分钟、5m 档每 5 分钟
AGGREGATE_1M_INTERVAL_S=60
AGGREGATE_5M_INTERVAL_S=300
# 每次聚合重算最近（N+1）个**完整**桶：迟到数据（Agent 重试/时钟修正）靠它自愈
DOWNSAMPLE_LOOKBACK_BUCKETS=3
# 单次清理最多删几批（每批 RETENTION_DELETE_BATCH_SIZE 行）；积压时下一轮继续
RETENTION_MAX_BATCHES_PER_RUN=50
# 分区提前量告警线（天）：剩余不足即 error 日志（须 ≤ PARTITION_PRE_CREATE_DAYS）
PARTITION_MIN_REMAINING_DAYS=7
