{
  "name": "vantage-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vantage Console 前端（Vue 3 + TypeScript + Element Plus）— 工程规格见 docs/frontend.md",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
